{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "BlockDecisionWire": {
      "enum": [
        "block"
      ],
      "type": "string"
    },
    "HookContextAffinity": {
      "description": "Applicability of synchronous PostToolUse additional context, not tool effects.",
      "oneOf": [
        {
          "description": "Preserve the historical behavior, including late conversation context.",
          "enum": [
            "conversation"
          ],
          "type": "string"
        },
        {
          "description": "Publish only while the task captured with the originating step is still current.",
          "enum": [
            "originating_task"
          ],
          "type": "string"
        }
      ]
    },
    "PostToolUseHookSpecificOutputWire": {
      "additionalProperties": false,
      "properties": {
        "additionalContext": {
          "default": null,
          "type": "string"
        },
        "additionalContextAffinity": {
          "allOf": [
            {
              "$ref": "#/definitions/HookContextAffinity"
            }
          ],
          "default": "conversation",
          "description": "Opt-in task affinity is supported only by synchronous PostToolUse handlers."
        },
        "hookEventName": {
          "const": "PostToolUse",
          "type": "string"
        },
        "updatedMCPToolOutput": {
          "default": null
        }
      },
      "required": [
        "hookEventName"
      ],
      "type": "object"
    }
  },
  "properties": {
    "continue": {
      "default": true,
      "type": "boolean"
    },
    "decision": {
      "allOf": [
        {
          "$ref": "#/definitions/BlockDecisionWire"
        }
      ],
      "default": null
    },
    "hookSpecificOutput": {
      "allOf": [
        {
          "$ref": "#/definitions/PostToolUseHookSpecificOutputWire"
        }
      ],
      "default": null
    },
    "reason": {
      "default": null,
      "type": "string"
    },
    "stopReason": {
      "default": null,
      "type": "string"
    },
    "suppressOutput": {
      "default": false,
      "type": "boolean"
    },
    "systemMessage": {
      "default": null,
      "type": "string"
    }
  },
  "title": "post-tool-use.command.output",
  "type": "object"
}